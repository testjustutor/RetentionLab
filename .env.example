# ===============================
# BASE APP CONFIG
# ===============================
BASE_URL=http://localhost:3000
PORT=3000

# ===============================
# DATABASE CONFIG
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=database name
DB_USER=database user name
DB_PASSWORD= database password

# ===============================
# BOT CONFIG
# ===============================
BOT_NAME="Assistant Bot"

NODE_ENV=development
# ===============================
# DATABASE
# ===============================
LOG_LEVEL=info
CHROME_PROFILE_PATH=./storage/chrome-profiles

# ===============================
# ZOOM CONFIG (special web client required)
# Format: https://zoom.us/wc/join/{MEETING_ID}?pwd={PASSCODE}
# ===============================
ZOOM_MEETING_LINK=https://us05web.zoom.us/wc/

# ===============================
# GOOGLE MEET CONFIG
# Direct links already usable → no wc needed
# ===============================
GOOGLE_MEET_BASE=https://meet.google.com/

# ===============================
# MICROSOFT TEAMS CONFIG
# Direct join links (web)
# ===============================
TEAMS_BASE=https://teams.live.com/meet/


# ===============================
# GOOGLE API
# ===============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_x509_CERT_URL=
GOOGLE_REDIRECT_URIS=
GOOGLE_REDIRECT_URIS=
GOOGLE_JAVASCRIPT_ORIGINS=


# ===============================
# SMTP / MAIL
# ===============================
# Gmail / Google Workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=XXXX@gmail.com
SMTP_PASS=XXXX
MAIL_FROM="Retention Lab <XXXX@gmail.com>"

# Outlook / Microsoft 365
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@outlook.com
# SMTP_PASS=your_mailbox_password_or_app_password
# MAIL_FROM="Retention Lab <yourname@outlook.com>"

# Custom domain mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# MAIL_FROM="Retention Lab <no-reply@retentionlab.local>"


JWT_SECRET=
JWT_EXPIRES_IN=12h

# ===============================
# PASSWORD SECRET KEY
# Used as a pepper to derive password hashes.
# IMPORTANT: Keep this secret! If changed, all existing passwords will become invalid.
# ===============================
PASSWORD_SECRET_KEY=

HF_TOKEN=your_huggingface_token_here

# ===============================
# AI / LLM CONFIG
# ===============================
GEMINI_API_KEY=your_google_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=your_cloude_api_key_here

# ===============================
# OPTIONAL SERVICES
# ===============================
WEBHOOK_URL=
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# AI Transcript button on Super Admin > Content > Video Processing — calls
# Deepgram's /v1/listen REST API directly (controllers/super_admin/content/
# videoProcessingController.js::generateTranscript). Leave blank to disable;
# the button will show a clear "DEEPGRAM_API_KEY is not set" error instead
# of crashing.
DEEPGRAM_API_KEY=

# ===== PYTHON ENGINE (isolated Whisper + diarization) =====
# WhisperX model size: tiny/base/small/medium/large-v3
PYTHON_ENGINE_MODEL_WHISPERX=large-v3
# Domain context for transcription prompt: math/science/english/...
PYTHON_ENGINE_SUBJECT=math
# Use WhisperX word-level pipeline (1 = yes)
PYTHON_ENGINE_USE_WHISPERX=1
# Managed AssemblyAI transcription+diarization backend - when 1 it replaces the
# local WhisperX/channel-split/Resemblyzer stack (requires ASSEMBLYAI_API_KEY).
PYTHON_ENGINE_USE_ASSEMBLYAI=0
ASSEMBLYAI_API_KEY=
# Names/terms to bias AssemblyAI recognition toward (comma separated).
PYTHON_ENGINE_WORD_BOOST=
# Hard kill for a hung processing run (ms). Default when unset: 2700000 (45 min).
PYTHON_ENGINE_TIMEOUT_MS=2700000
# Max seconds for ONE AI audit LLM call (gemini/openai/anthropic/ollama).
AI_CALL_TIMEOUT=180

# ===== AI TOKEN-COST CONTROLS (audit call) =====
# Cap on the audit call's output tokens - a cost safety net, not a behavior
# change (the JSON schema is small; this only stops a runaway completion).
# NOTE: on thinking-capable Gemini models this cap applies to thinking +
# visible output COMBINED - see GEMINI_DISABLE_THINKING below, which is why
# this needs real headroom rather than being set to the JSON's bare minimum.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Turns off Gemini's extended "thinking"/reasoning tokens for the audit call.
# This is a deterministic scoring task (the rubric + rules are fully spelled
# out in the prompt), so thinking isn't earning its token cost here - and
# worse, on models where thinking eats into GEMINI_MAX_OUTPUT_TOKENS above,
# heavy thinking can leave too little budget for the actual JSON and
# truncate it mid-object (this happened once during testing). Leave "true"
# unless you have a specific reason to want reasoning on for this call.
GEMINI_DISABLE_THINKING=true
# Gemini explicit context caching for the audit call's static content (system
# instruction + rubric indicator catalog - identical on every call for a given
# rubric, ~44% of the prompt). Off by default; flip to "true" only after
# verifying it against the live Gemini API - see services/engine/gemini_cache.py
# and ai_client.py's _ask_gemini_with_key. Rubric edits are picked up
# automatically (the cache key is a hash of the indicator catalog text), so
# nothing needs manual invalidation when the rubric changes.
GEMINI_USE_CACHING=false
# How long a created cache stays valid before a fresh one is made (seconds).
GEMINI_CACHE_TTL_SECONDS=3600
# Skip attempting to cache content estimated below this many tokens (Gemini
# rejects caches.create() below its own minimum; tune if your model's floor differs).
GEMINI_CACHE_MIN_TOKENS=1024

# Development-only: set to "true" to allow requireAuth to accept x-user-id /
# x-user-role / x-user-company headers in place of a token. Never enable in production.
# ENABLE_HEADER_AUTH=true
