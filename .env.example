# ===============================
# BASE APP CONFIG
# ===============================
BASE_URL=http://localhost:3000
PORT=3000

# ===============================
# BOT CONFIG
# ===============================
BOT_NAME="Assistant Bot"

# ===============================
# DATABASE
# ===============================
DB_PATH=./transcripts.db
LOG_LEVEL=info

# ===============================
# ZOOM CONFIG (special web client required)
# Format: https://zoom.us/wc/join/{MEETING_ID}?pwd={PASSCODE}
# ===============================
ZOOM_MEETING_LINK=https://us05web.zoom.us/wc/

# ===============================
# GOOGLE MEET CONFIG
# Direct links already usable → no wc needed
# ===============================
GOOGLE_MEET_BASE=https://meet.google.com/

# ===============================
# MICROSOFT TEAMS CONFIG
# Direct join links (web)
# ===============================
TEAMS_BASE=https://teams.live.com/meet/

# ===============================
# GOOGLE API
# ===============================
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# ===============================
# AI / LLM CONFIG
# ===============================
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# ===============================
# OPTIONAL SERVICES
# ===============================
WEBHOOK_URL=
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1