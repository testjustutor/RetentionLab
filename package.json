{
  "name": "retention-lab",
  "version": "1.0.0",
  "description": "AI-powered meeting intelligence and retention platform for Zoom, Google Meet, and Teams",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "api": "node api-server.js",
    "dev:api": "nodemon api-server.js",
    "db:init": "node -e \"require('./database/db').initDB()\"",
    "db:seed": "node database/setup-mysql.js",
    "db:reset": "node database/reset-db.js --force",
    "db:migrate": "node database/reset-db.js --migrate-only",
    "db:manual-seed": "node database/run-manual-seeders.js",
    "build": "npm run db:init && npm run db:seed && echo 'Build Complete: Database synced and environment verified.'"
  },
  "keywords": [
    "zoom",
    "google-meet",
    "teams",
    "transcription",
    "puppeteer",
    "bot"
  ],
  "author": "JustTutors",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.3.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "form-data": "^4.0.5",
    "google-auth-library": "^9.0.0",
    "googleapis": "^129.0.0",
    "jsonwebtoken": "^9.0.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^8.0.10",
    "openai": "^6.38.0",
    "puppeteer": "^23.5.3",
    "puppeteer-stream": "^3.0.4",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
